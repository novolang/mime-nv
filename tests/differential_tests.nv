// differential_tests.nv — this package against Python's standard
// library, which answers the same questions independently.
//
// Written by tools/differential.py; do not edit by hand.  The
// `email` package supplies the essence, charset and boundary of each
// header, and `mimetypes`, with its built-in map only, the type of
// each extension both tables know.
//
// The two extension tables disagree on 30 extensions, which are not
// asserted.  This package answers mime_guess's type; Python's is second:
//
//   .3g2      video/3gpp2                      audio/3gpp2
//   .3gp      video/3gpp                       audio/3gpp
//   .3gpp     video/3gpp                       audio/3gpp
//   .aif      audio/aiff                       audio/x-aiff
//   .aifc     audio/aiff                       audio/x-aiff
//   .aiff     audio/aiff                       audio/x-aiff
//   .bat      application/x-msdownload         text/plain
//   .cdf      application/x-cdf                application/x-netcdf
//   .dll      application/x-msdownload         application/octet-stream
//   .ico      image/x-icon                     image/vnd.microsoft.icon
//   .m3u      audio/x-mpegurl                  application/vnd.apple.mpegurl
//   .m3u8     audio/x-mpegurl                  application/vnd.apple.mpegurl
//   .mid      audio/mid                        audio/midi
//   .midi     audio/mid                        audio/midi
//   .mif      application/vnd.mif              application/x-mif
//   .mjs      application/javascript           text/javascript
//   .obj      application/x-tgif               application/octet-stream
//   .opus     audio/ogg                        audio/opus
//   .pl       application/x-perl               text/plain
//   .py       text/plain                       text/x-python
//   .ram      audio/x-pn-realaudio             application/x-pn-realaudio
//   .rdf      application/rdf+xml              application/xml
//   .sgm      text/sgml                        text/x-sgml
//   .sgml     text/sgml                        text/x-sgml
//   .srt      application/x-subrip             text/plain
//   .tgz      application/x-compressed         application/x-tar
//   .wav      audio/wav                        audio/x-wav
//   .wsdl     text/xml                         application/xml
//   .xsl      text/xml                         application/xml
//   .xul      application/vnd.mozilla.xul+xml  text/xul

use std.test
use mimeext
use mimetype

// Each header, and what Python's `email` package answers for it:
// the essence, the charset, and the boundary.
fn headers() -> [(Str, Str, Str, Str)]
    [
        ("text/html", "text/html", "", ""),
        ("TEXT/HTML", "text/html", "", ""),
        ("text/html; charset=utf-8", "text/html", "utf-8", ""),
        ("text/html; charset=UTF-8", "text/html", "utf-8", ""),
        ("text/html;charset=ISO-8859-1", "text/html", "iso-8859-1", ""),
        ("text/html ;  charset=\"utf-8\"", "text/html", "utf-8", ""),
        ("text/plain; format=flowed; charset=us-ascii", "text/plain", "us-ascii", ""),
        ("application/json", "application/json", "", ""),
        ("application/vnd.api+json; charset=utf-8", "application/vnd.api+json", "utf-8", ""),
        ("image/svg+xml", "image/svg+xml", "", ""),
        ("multipart/form-data; boundary=----WebKitFormBoundary7MA4YWxkTrZu0gW",
        "multipart/form-data",
        "",
        "----WebKitFormBoundary7MA4YWxkTrZu0gW"),
        ("multipart/form-data; boundary=\"---=_Part_0_1\"", "multipart/form-data", "", "---=_Part_0_1"),
        ("multipart/mixed; boundary=\"simple boundary\"", "multipart/mixed", "", "simple boundary"),
        ("multipart/alternative; boundary=\"a\\\"b\"", "multipart/alternative", "", "a\"b"),
        ("Multipart/Related; boundary=xyz; type=\"text/html\"", "multipart/related", "", "xyz"),
        ("text/plain; charset=utf-8; charset=latin1", "text/plain", "utf-8", ""),
        ("message/rfc822", "message/rfc822", "", ""),
        ("application/octet-stream", "application/octet-stream", "", ""),
        ("text/csv; header=present; charset=utf-8", "text/csv", "utf-8", ""),
        ("application/x-www-form-urlencoded", "application/x-www-form-urlencoded", "", "")]

