// embedded_probe.nv — `mimecode` and `mimesniff_core` on a
// microcontroller, as a program that builds for a Cortex-M, boots there
// and checks its answers.
//
// It is built with
//
//   novo build --target=nrf52-qemu tests/embedded_probe.nv
//
// which produces a Cortex-M4 executable or fails.  `--target=nrf52-qemu`
// stamps `@tier(embedded)` on every function it compiles, so a `Str`
// concatenation, a `Bytes` call or a list literal in either module is
// refused where it is written.  The same executable boots under
//
//   qemu-system-arm -machine mps2-an386 -nographic -semihosting -kernel probe.elf
//
// and prints `PASS: mime-embedded` when every check below holds.
//
// A firmware HTTP server answering `GET /logo.png` off a flash
// filesystem needs a `Content-Type` and has no heap to build one in.
// The path shown here is integers: a code from the first bytes, and
// `mimecode.code_name` at the end, a constant in flash.
//
// `mimetype`, `mimeext`, `mimesniff` and `mimeaccept` are not used.
// They take `Str` and `Bytes` and build lists, and one host-only
// function anywhere in a compilation unit is an undefined symbol at link
// time whether or not the firmware calls it.

use mimecode
use mimesniff_core

// Feed the eight bytes of a PNG signature to a sniff.
@tier(rt)
fn feed_png(start: MimeSniff) -> MimeSniff
    var s = start
    s = mimesniff_core.sniff_byte(s, 0x89)
    s = mimesniff_core.sniff_byte(s, 0x50)
    s = mimesniff_core.sniff_byte(s, 0x4E)
    s = mimesniff_core.sniff_byte(s, 0x47)
    s = mimesniff_core.sniff_byte(s, 0x0D)
    s = mimesniff_core.sniff_byte(s, 0x0A)
    s = mimesniff_core.sniff_byte(s, 0x1A)
    mimesniff_core.sniff_byte(s, 0x0A)

// Every answer this probe checks, counted, so a single comparison
// decides the run and a device that disagrees with the host says how
// many checks it lost.
@tier(rt)
fn score() -> Int
    var n = 0
    // The vocabulary as integers.
    let png = mimecode.image_png()
    if png != mimecode.unknown()
        n = n + 1
    if mimecode.code_is_text(mimecode.text_html())
        n = n + 1
    if mimecode.code_is_text(png) == false
        n = n + 1
    if mimecode.code_is_inline(png)
        n = n + 1
    if mimecode.code_charset(mimecode.text_html()) == "utf-8"
        n = n + 1
    if mimecode.code_count() == 31 and mimecode.code_at(0) == mimecode.text_html()
        n = n + 1
    // A name read into a code, which is what a device does with the
    // `Content-Type` of a request it received.
    if mimecode.code_named("IMAGE/PNG; x=1") == png
        n = n + 1
    // The sniff built in this frame, fed a PNG signature, and read back.
    var s = mimesniff_core.sniff_start(mimesniff_core.ctx_browsing())
    if mimesniff_core.sniff_pos(s) == 0 and mimesniff_core.sniff_settled(s) == false
        n = n + 1
    s = feed_png(s)
    if mimesniff_core.sniff_pos(s) == 8 and mimesniff_core.sniff_settled(s)
        n = n + 1
    if mimesniff_core.sniff_code(s) == png and mimesniff_core.sniff_binary(s)
        n = n + 1
    // HTML after leading whitespace, in the general table.
    var h = mimesniff_core.sniff_start(mimesniff_core.ctx_browsing())
    h = mimesniff_core.sniff_byte(h, ' ')
    h = mimesniff_core.sniff_byte(h, '<')
    h = mimesniff_core.sniff_byte(h, 'p')
    h = mimesniff_core.sniff_byte(h, '>')
    if mimesniff_core.sniff_code(h) == mimecode.text_html()
        n = n + 1
    // The same bytes with the scriptable rows off are text.
    var t = mimesniff_core.sniff_start(mimesniff_core.ctx_browsing_unscriptable())
    t = mimesniff_core.sniff_byte(t, '<')
    t = mimesniff_core.sniff_byte(t, 'p')
    t = mimesniff_core.sniff_byte(t, '>')
    if mimesniff_core.sniff_code(mimesniff_core.sniff_end(t)) == mimecode.text_plain()
        n = n + 1
    // An empty resource in the image context matches no image row.
    let e = mimesniff_core.sniff_end(mimesniff_core.sniff_start(mimesniff_core.ctx_image()))
    if mimesniff_core.sniff_settled(e) and mimesniff_core.sniff_code(e) == mimecode.unknown()
        n = n + 1
    if mimesniff_core.header_bytes() == 1445
        n = n + 1
    // And the name a server writes, from flash.
    if mimecode.code_name(mimesniff_core.sniff_code(s)) == "image/png"
        n = n + 1
    n

@tier(rt)
fn main() [hw, time]
    bsp.board.init()
    // 15 is the number of checks in `score`.
    if score() == 15
        hal.uart.write("PASS: mime-embedded\n")
    else
        hal.uart.write("FAIL: mime-embedded\n")
    loop
        core.rt.sleep_ms(1000)
