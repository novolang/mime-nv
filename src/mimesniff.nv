// mimesniff.nv — the WHATWG MIME Sniffing Standard over a resource's
// first bytes, the type a server supplied, and `nosniff`.
//
// Sniffing is working out what a resource is from its leading bytes.
// Browsers do it because servers get `Content-Type` wrong, and the
// standard fixes exactly when they may: the answer depends on the
// bytes, on the supplied type and on the no-sniff flag, which
// `X-Content-Type-Options: nosniff` sets.  `sniff_with` takes all
// three.  `sniff` takes the bytes alone, for data that arrived with no
// type at all.
//
// The supplied type decides most of the answer (section 7):
//
//   1. An HTML or XML type is kept.
//   2. No type, or `unknown/unknown`, `application/unknown` or `*/*`,
//      is sniffed with the whole table.  With `nosniff` the HTML, XML
//      and PDF rows are skipped, but the rest still runs.
//   3. Otherwise, with `nosniff`, the supplied type is kept.
//   4. One of the four `text/plain` spellings an old Apache bug sends
//      can only become `application/octet-stream`, never HTML.
//   5. An image type can become another image type, and an audio or
//      video type another audio or video type, when the bytes match.
//   6. Anything else is kept.
//
// The pattern tables and the walk over them are `mimesniff_core`, which
// a microcontroller can run.  This module feeds it from `Bytes`.
//
// An answer is a `mimecode` integer.  When the answer is a supplied
// type that has no code, it is `mimecode.unknown()`, and `would_sniff`
// answering `false` tells a caller that its own string stands.

use mimecode
use mimesniff_core
use mimetype

// Which of the standard's algorithms to run.
pub enum MimeSniffContext
    // The general algorithm (sections 7 and 8.1), which is what a
    // browser runs for a page and what a file server wants.
    MimeSniffBrowsing
    // The rules for distinguishing whether a resource is text or binary
    // (section 7.2).  The answer is `text/plain` or
    // `application/octet-stream` and nothing else.
    MimeSniffTextOrBinary
    // Sniffing in an image context (section 8.2): the image rows
    // alone.
    MimeSniffImage
    // Sniffing in an audio or video context (section 8.3): the audio
    // and video rows alone.
    MimeSniffAudioVideo

// How many leading bytes the algorithm ever looks at: 1445, the
// standard's resource header size (section 5.2).
//
// A server reading a file to decide its type reads this many bytes and
// no more.
pub fn header_bytes() -> Int []
    mimesniff_core.header_bytes()

// The `mimesniff_core` context code for a context.
pub fn context_code(ctx: MimeSniffContext) -> Int []
    match ctx
        MimeSniffBrowsing     => mimesniff_core.ctx_browsing()
        MimeSniffTextOrBinary => mimesniff_core.ctx_text_or_binary()
        MimeSniffImage        => mimesniff_core.ctx_image()
        MimeSniffAudioVideo   => mimesniff_core.ctx_audio_video()

// Run the walk for a context code over the first bytes of `head`.
fn walk(head: Bytes, ctx_code: Int) -> Int
    var s = mimesniff_core.sniff_start(ctx_code)
    let n = bytes.len(head)
    for i in 0..n
        if mimesniff_core.sniff_settled(s)
            break
        s = mimesniff_core.sniff_byte(s, bytes.byte_at(head, i) ?? 0)
    mimesniff_core.sniff_code(mimesniff_core.sniff_end(s))

// What the bytes say, with no supplied type.
//
// The general context runs the whole table with the HTML rows included,
// which is what the standard does for a resource with no type (section
// 7, step 2).  A caller that has a `Content-Type` uses `sniff_with`.
//
// ```novo
// use mimecode
// use mimesniff
//
// fn main() [io]
//     let head = bytes.from_hex("89504e470d0a1a0a") ?? bytes.zeros(0)
//     println(mimecode.code_name(mimesniff.sniff(head, MimeSniffBrowsing)))
// ```
pub fn sniff(head: Bytes, ctx: MimeSniffContext) -> Int []
    walk(head, context_code(ctx))

// The parsed form of a supplied type, or `None` when the standard
// treats it as undefined: empty, or not a media type at all (section
// 5.1).
fn supplied_type(supplied: Str) -> ?MimeType
    match mimetype.parse(supplied)
        Ok(m)  => Some(m)
        Err(_) => None

// Whether a parsed type is an XML MIME type: `text/xml`,
// `application/xml`, or any subtype ending in `+xml`.
fn is_xml(supplied: Str, m: MimeType) -> Bool
    if mimetype.suffix_of(supplied, m) == "xml"
        return true
    mimetype.essence_eq(supplied, m, "text/xml") or mimetype.essence_eq(supplied, m, "application/xml")

// Whether a parsed type is one the standard sniffs as though no type
// had been supplied.
fn is_unknown_type(supplied: Str, m: MimeType) -> Bool
    if mimetype.essence_eq(supplied, m, "unknown/unknown")
        return true
    mimetype.essence_eq(supplied, m, "application/unknown") or mimetype.essence_eq(supplied, m, "*/*")

// Whether a supplied type is one of the four exact byte strings that
// set the standard's check-for-apache-bug flag (section 5.1).
fn apache_bug(supplied: Str) -> Bool
    if supplied == "text/plain" or supplied == "text/plain; charset=ISO-8859-1"
        return true
    supplied == "text/plain; charset=iso-8859-1" or supplied == "text/plain; charset=UTF-8"

// What a browser would decide, given what the server said and whether
// it said `nosniff`.
//
// `supplied` is the `Content-Type` value the server sent, or `""` for
// none.  The rules are the standard's (section 7, and 8.2 and 8.3 for
// the image and audio-video contexts), and they are not "the bytes
// win":
//
// - An HTML or XML type is kept.
// - No type, `unknown/unknown`, `application/unknown` or `*/*` runs the
//   whole table; `nosniff` removes the HTML, XML and PDF rows from it.
// - Otherwise `nosniff` keeps the supplied type.
// - `text/plain`, spelled as an old Apache server sends it, becomes
//   `application/octet-stream` when the bytes are binary and stays
//   `text/plain` otherwise.  It never becomes HTML.
// - An image type can become another image type, and an audio or video
//   type another audio or video type.
// - Anything else is kept.
//
// The text-or-binary context runs section 7.2's rules unless the
// supplied type is HTML or XML or `nosniff` is set.  The image and
// audio-video contexts keep an XML type and otherwise answer the
// pattern that matched or the supplied type.
//
// ```novo
// use mimecode
// use mimesniff
//
// fn main() [io]
//     let page = bytes.from_str("<!DOCTYPE html><p>hello")
//     // No type at all: the bytes are sniffed, and they are HTML.
//     println(mimecode.code_name(mimesniff.sniff_with(page, "", false, MimeSniffBrowsing)))
//     // Served as text/plain: a browser never makes that HTML.
//     println(mimecode.code_name(mimesniff.sniff_with(page, "text/plain", false, MimeSniffBrowsing)))
// ```
pub fn sniff_with(head: Bytes, supplied: Str, nosniff: Bool, ctx: MimeSniffContext) -> Int []
    let kept = mimecode.code_named(supplied)
    match supplied_type(supplied)
        None    =>
            match ctx
                MimeSniffBrowsing =>
                    if nosniff
                        return walk(head, mimesniff_core.ctx_browsing_unscriptable())
                    walk(head, mimesniff_core.ctx_browsing())
                _                 => sniff(head, ctx)
        Some(m) =>
            if is_xml(supplied, m)
                return kept
            match ctx
                MimeSniffBrowsing     => sniff_browsing(head, supplied, m, nosniff)
                MimeSniffTextOrBinary =>
                    if nosniff or mimetype.essence_eq(supplied, m, "text/html")
                        return kept
                    sniff(head, ctx)
                MimeSniffImage        => matched_or(sniff(head, ctx), kept)
                MimeSniffAudioVideo   => matched_or(sniff(head, ctx), kept)

// The pattern that matched, or the supplied type's code when none did.
fn matched_or(found: Int, kept: Int) -> Int
    if found == mimecode.unknown()
        return kept
    found

// Section 7 for a supplied type that parsed and is not XML.
fn sniff_browsing(head: Bytes, supplied: Str, m: MimeType, nosniff: Bool) -> Int
    let kept = mimecode.code_named(supplied)
    if mimetype.essence_eq(supplied, m, "text/html")
        return kept
    if is_unknown_type(supplied, m)
        if nosniff
            return walk(head, mimesniff_core.ctx_browsing_unscriptable())
        return walk(head, mimesniff_core.ctx_browsing())
    if nosniff
        return kept
    if apache_bug(supplied)
        return walk(head, mimesniff_core.ctx_text_or_binary())
    let family = mimetype.type_of(supplied, m)
    if family == "image"
        return matched_or(walk(head, mimesniff_core.ctx_image()), kept)
    if family == "audio" or family == "video"
        return matched_or(walk(head, mimesniff_core.ctx_audio_video()), kept)
    kept

// Whether a browser would consult the bytes at all, given a supplied
// type and the flag, in the general context.
//
// A server asks this about its own response.  `true` means a client may
// decide the response is something other than what was said.  A missing
// or unknown type is sniffed even with `nosniff`, which only removes
// the HTML, XML and PDF rows; the way to stop sniffing is to supply a
// real type and `nosniff` together.
pub fn would_sniff(supplied: Str, nosniff: Bool) -> Bool []
    match supplied_type(supplied)
        None    => true
        Some(m) =>
            if is_xml(supplied, m) or mimetype.essence_eq(supplied, m, "text/html")
                return false
            if is_unknown_type(supplied, m)
                return true
            if nosniff
                return false
            if apache_bug(supplied)
                return true
            let family = mimetype.type_of(supplied, m)
            family == "image" or family == "audio" or family == "video"

// Whether a supplied type counts as no type at all, so that the whole
// table decides (section 7, step 2).
//
// That is `""`, a value that is not a media type, `unknown/unknown`,
// `application/unknown` and `*/*`.  Every other type is kept or changed
// only within its own family, which `would_sniff` answers.
pub fn is_sniffable_type(supplied: Str) -> Bool []
    match supplied_type(supplied)
        None    => true
        Some(m) => is_unknown_type(supplied, m)

// Whether the bytes contain a binary data byte (section 3): 0x00 to
// 0x08, 0x0B, 0x0E to 0x1A, or 0x1C to 0x1F.
//
// Tab, line feed, form feed, carriage return and escape are text.
// Only the first `header_bytes()` bytes are read, as the standard does.
pub fn looks_binary(head: Bytes) -> Bool []
    let n = bytes.len(head)
    var s = mimesniff_core.sniff_start(mimesniff_core.ctx_text_or_binary())
    for i in 0..n
        if i >= header_bytes()
            break
        s = mimesniff_core.sniff_byte(s, bytes.byte_at(head, i) ?? 0)
        if mimesniff_core.sniff_binary(s)
            return true
    mimesniff_core.sniff_binary(s)

// The byte order mark's encoding, as an IANA charset name, or `""`.
//
// `EF BB BF` is `utf-8`, `FE FF` is `utf-16be`, and `FF FE` is
// `utf-16le`.  A UTF-16 file read as UTF-8 decodes as nulls rather than
// as mojibake.
pub fn bom_charset(head: Bytes) -> Str []
    let b0 = bytes.byte_at(head, 0) ?? 0
    let b1 = bytes.byte_at(head, 1) ?? 0
    let b2 = bytes.byte_at(head, 2) ?? 0
    if b0 == 239 and b1 == 187 and b2 == 191
        return "utf-8"
    if b0 == 254 and b1 == 255
        return "utf-16be"
    if b0 == 255 and b1 == 254
        return "utf-16le"
    ""

// How many bytes of byte order mark to skip: 3, 2 or 0.
pub fn bom_len(head: Bytes) -> Int []
    let cs = bom_charset(head)
    if cs == "utf-8"
        return 3
    if cs == ""
        return 0
    2
