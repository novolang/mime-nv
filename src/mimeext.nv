// The extension to prefer for a media type, where it is not the first
// the table lists, or `""`.
fn preferred_of(media_type: Str) -> Str
    match media_type
        "application/octet-stream"      => "bin"
        "text/xml"                      => "xml"
        "application/postscript"        => "ps"
        "text/plain"                    => "txt"
        "text/javascript"               => "js"
        "text/html"                     => "html"
        "image/jpeg"                    => "jpg"
        "video/mpeg"                    => "mpeg"
        "audio/mpeg"                    => "mp3"
        "application/x-shockwave-flash" => "swf"
        "image/pict"                    => "pict"
        "application/vnd.ms-powerpoint" => "ppt"
        "application/vnd.ms-excel"      => "xls"
        "image/tiff"                    => "tiff"
        _                               => ""
