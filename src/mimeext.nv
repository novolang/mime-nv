// mimeext.nv — the extension table, looked up both ways.
//
// A file's extension is evidence of what whoever named the file
// believed.  It is weak evidence, and it is the only evidence a static
// file server has before it opens the file.
//
// The table is the Rust crate `mime_guess`'s, about 1400 extensions
// drawn from Apache's `mime.types`, jshttp's mime-db and MimeTypeMap.
// Taking an existing list rather than curating one keeps this package
// in agreement with the servers that use the same sources.  Where the
// crate lists several types for an extension, the first is the answer.
//
// One media type has several extensions: `image/jpeg` is `.jpg`,
// `.jpeg`, `.jpe` and `.jfif`.  `exts_for_type` answers all of them,
// and `preferred_ext` picks the one to use when naming a new file.
//
// Every extension this module answers carries its leading dot and is
// lowercase.  Every extension it is given may be written with or
// without the dot, in any case.
//
// The name and the bytes can disagree.  `mimesniff` answers what the
// bytes say and this module answers what the name says, and neither
// overrules the other.

use mimecode
use mimetype

// The ASCII lowercase of a byte.
fn lower(b: Int) -> Int
    if b >= 'A' and b <= 'Z'
        return b + 32
    b

// Compare `ext` from offset `from`, lowercased, with a table key:
// negative, zero or positive, bytewise.
fn compare(ext: Str, from: Int, key: Str) -> Int
    let n = str.len(ext) - from
    let k = str.len(key)
    for i in 0..n
        if i >= k
            return 1
        let a = lower(str.byte_at_or(ext, from + i, 0))
        let b = str.byte_at_or(key, i, 0)
        if a != b
            return a - b
    n - k

// The table entry for an extension, or -1.
fn find(ext: Str) -> Int
    var from = 0
    if str.byte_at_or(ext, 0, 0) == '.'
        from = 1
    if str.len(ext) <= from
        return 0 - 1
    var lo = 0
    var hi = ENTRIES
    for _ in 0..ENTRIES
        if lo >= hi
            break
        let mid = (lo + hi) / 2
        let c = compare(ext, from, entry_ext(mid))
        if c == 0
            return mid
        if c < 0
            hi = mid
        else
            lo = mid + 1
    0 - 1

// The first of a comma-joined list of types.
fn first_type(types: Str) -> Str
    match str.index(types, ",")
        Some(i) => str.slice(types, 0, i)
        None    => types

// The media-type code for an extension, or `mimecode.unknown()`.
//
// The extension may be written with or without its dot and in any
// case.  An extension whose type has no code answers `unknown()` even
// when `type_for_ext` knows the type.
//
// ```novo
// use mimecode
// use mimeext
//
// fn main() [io]
//     println(mimecode.code_name(mimeext.code_for_ext(".png")))
// ```
pub fn code_for_ext(ext: Str) -> Int []
    mimecode.code_named(type_for_ext(ext))

// The media type an extension names, or `""`.
//
// `""` and not `application/octet-stream`: "the table has no entry" and
// "this is bytes" are different answers.
//
// ```novo
// use mimeext
//
// fn main() [io]
//     println(mimeext.type_for_ext("SVG"))   // image/svg+xml
// ```
pub fn type_for_ext(ext: Str) -> Str []
    let i = find(ext)
    if i < 0
        return ""
    first_type(entry_types(i))

// The media type a file name implies, from its last extension, or `""`.
//
// `archive.tar.gz` answers `application/gzip`: the last extension is
// the outermost encoding.  A name with no extension answers `""`.
pub fn type_for_name(filename: Str) -> Str []
    let ext = ext_of(filename)
    if ext == ""
        return ""
    type_for_ext(ext)

// The media-type code a file name implies, or `mimecode.unknown()`.
pub fn code_for_name(filename: Str) -> Int []
    mimecode.code_named(type_for_name(filename))

// The essence of a media type, lowercased, or the text lowercased when
// it does not parse.
fn essence_of(media_type: Str) -> Str
    match mimetype.parse(media_type)
        Ok(m)  => mimetype.essence(media_type, m)
        Err(_) => str.lower(media_type)

// Whether a comma-joined list of types holds `t`, which is lowercase.
// A few of the table's types are written with capitals, and a type is
// case-insensitive.
fn lists(types: Str, t: Str) -> Bool
    for each in str.split(types, ",")
        if str.lower(each) == t
            return true
    false

// Every extension a media type is known by, in the table's order.
//
// The type is compared by essence, so `text/html; charset=utf-8`
// answers the same as `text/html`.  An extension counts when the type
// is any of those the table lists for it, so `.gz` is an extension of
// both `application/gzip` and `application/x-gzip`.
pub fn exts_for_type(media_type: Str) -> [Str] []
    let t = essence_of(media_type)
    var out: [Str] = []
    for i in 0..ENTRIES
        if lists(entry_types(i), t)
            list.push(out, "." + entry_ext(i))
    out

// The extension to use when naming a file of this type, or `""` for a
// type the table does not know.
//
// Of the extensions `exts_for_type` answers, this is the one Python's
// `mimetypes.guess_extension` picks where it picks one of them, and
// the first in the table's order otherwise.  `image/jpeg` answers
// `.jpg` and `text/plain` answers `.txt`.
pub fn preferred_ext(media_type: Str) -> Str []
    let t = essence_of(media_type)
    let chosen = preferred_of(t)
    if chosen != ""
        return "." + chosen
    for i in 0..ENTRIES
        if lists(entry_types(i), t)
            return "." + entry_ext(i)
    ""

// The extension part of a file name, lowercased, with its dot, or `""`.
//
// Only the last path segment counts, after the last `/` or `\`.  A
// leading dot marks a hidden file rather than an extension, so
// `.gitignore` answers `""`, as does `README`, and a name ending in a
// dot.
pub fn ext_of(filename: Str) -> Str []
    let n = str.len(filename)
    var base = 0
    var dot = 0 - 1
    for i in 0..n
        let b = str.byte_at_or(filename, i, 0)
        if b == '/' or b == '\\'
            base = i + 1
            dot = 0 - 1
        else if b == '.'
            dot = i
    if dot <= base or dot == n - 1
        return ""
    str.lower(str.slice(filename, dot, n))

// How many entries the extension table holds.
pub fn ext_count() -> Int []
    ENTRIES

// The extension at an index below `ext_count()`, with its dot, or `""`
// for an index outside that range.
//
// The table is sorted bytewise by extension.
pub fn ext_at(index: Int) -> Str []
    if index < 0 or index >= ENTRIES
        return ""
    "." + entry_ext(index)

// Whether the table has an entry for an extension.
pub fn knows_ext(ext: Str) -> Bool []
    find(ext) >= 0

// The extension table.
//
// Generated by tools/ext_table.py from mime_guess 90f3d09696f7,
// src/mime_types.rs (MIT).  Sorted bytewise by extension, which is
// what `find` searches.  Do not edit by hand.

const ENTRIES: Int = 1379

// The extension of entry `i`, without its dot.  Every caller passes
// an index below ENTRIES, so the last arm is the last entry.
fn entry_ext(i: Int) -> Str
