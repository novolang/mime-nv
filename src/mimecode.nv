// The full `type/subtype` a code stands for.
//
// From a constant, so the bytes are in flash on a device rather than
// built in RAM.  The one call in this module that produces text.
//
// ```novo
// use mimecode
//
// fn main() [io]
//     println(mimecode.code_name(mimecode.image_png()))
// ```
pub fn code_name(code: Int) -> Str []
    todo("mime-nv.mimecode.code_name")

// The code a `type/subtype` names, or `unknown()`.
//
// Compared ASCII-case-insensitively, because RFC 2045 § 5.1 says type
// and subtype are case-insensitive and browsers implement exactly that.
// Parameters are ignored: `text/html; charset=utf-8` is `text/html`.
pub fn code_named(essence: Str) -> Int []
    todo("mime-nv.mimecode.code_named")

// The `charset=utf-8` a code should be served with, or `""`.
//
// Published because getting this wrong is a bug with a visible symptom:
// a `text/html` served without a charset is rendered with the browser's
// locale default, and a page of UTF-8 read as Windows-1252 shows the
// mojibake every non-English site has had at least once.  The types
// that want a charset are the text ones and the two structured
// text-based ones, and the list belongs beside the codes rather than in
// a server's own `if`.
pub fn code_charset(code: Int) -> Str []
    todo("mime-nv.mimecode.code_charset")

// Whether a code names a type that a browser will render inline rather
// than download.
//
// What a server deciding `Content-Disposition` asks, and a security
// question rather than a convenience one: a user-uploaded file served
// as `text/html` runs script on the serving origin, which is why an
// upload endpoint pins its own type and sends `nosniff`.
pub fn code_is_inline(code: Int) -> Bool []
    todo("mime-nv.mimecode.code_is_inline")

// Whether a code is one of the text types.
//
// `text/*`, plus the structured types whose bytes are text —
// `application/json`, `application/xml`, `application/javascript`,
// `image/svg+xml`.  The set a caller compresses, and the set a caller
// decodes as characters rather than handling as bytes.
pub fn code_is_text(code: Int) -> Bool []
    todo("mime-nv.mimecode.code_is_text")

// How many codes there are.
//
// For a caller iterating them — a server printing what it can serve, a
// test asserting the table is complete.
pub fn code_count() -> Int []
    todo("mime-nv.mimecode.code_count")

// The code at an index below `code_count()`.
pub fn code_at(index: Int) -> Int []
    todo("mime-nv.mimecode.code_at")
